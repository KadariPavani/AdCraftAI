# Recommended .gitignore for this Python project
# Adjust entries if you *do* want to keep any of these in source control.

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/
parts/
sdist/
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
ENV/
env/

# Environment variables / secrets
.env
.env.*
secrets.json
*.pem
*.key

# VSCode
.vscode/
*.code-workspace
.claude/
# Pytest / cache
.pytest_cache/
.cache/

# Type checkers
.mypy_cache/
.pyright/

# IDEs
.idea/
*.iml

# OS files
.DS_Store
Thumbs.db

# Logs and runtime files
*.log
*.pid

# Database / local data
*.sqlite3
*.db

# Project-specific large/generated folders (ignore by default)
data/
outputs/
embeddings/
processed/
products_db/
uploads/

# FAISS / index files
embeddings/faiss_indexes/
data/indices/
*.index
*.idx
*.faiss

# Keep track of source and small config files only — remove entries above if you need to commit
